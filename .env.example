# Evals LLM provider (only needed for `npm run test:evals`)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the LLM endpoint (defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: responses (default) or chat.completions
# EVAL_API=responses

# Optional: OpenAI Responses reasoning effort (none | minimal | low | medium | high | xhigh)
# EVAL_REASONING_EFFORT=medium
